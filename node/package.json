{
  "name": "ledger-demo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start:api": "node --env-file-if-exists=.env src/api/main.ts",
    "dev:api": "node --env-file-if-exists=.env --watch src/api/main.ts",
    "reconcile": "node --env-file-if-exists=.env scripts/reconcile.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:db:reset": "docker compose -f ../docker-compose.yml run --rm migrate-test drop && docker compose -f ../docker-compose.yml run --rm migrate-test up"
  },
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "typeid-js": "1.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
