# Copy to .env for running the API locally against the compose services (npm run dev:api).
# .env is gitignored. Node loads it itself (--env-file-if-exists); no dotenv package needed.
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable
NATS_URL=nats://localhost:4222
PORT=3000
LOG_LEVEL=info
